<Window x:Class="AplicacionMVP.Vista.VentanaGenerarAmonestacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Generación de Carta de Amonestación" Height="520" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <StackPanel>
                <TextBlock Text="Generación de Amonestación Laboral" FontSize="20" FontWeight="Bold" Foreground="#C0392B" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock x:Name="txtEncabezado" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="White" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Vista previa del documento oficial:" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                        <TextBlock Text="CARTA OFICIAL DE AMONESTACIÓN" Margin="0,0,0,15"/>
                        <TextBlock x:Name="txtFecha" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtEstimado" Margin="0,0,0,15"/>
                        <TextBlock x:Name="txtCuerpo" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,15"/>
                        <TextBlock Text="Atentamente," Margin="0,0,0,5"/>
                        <TextBlock Text="La Administración." FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Botones Inferiores -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Content="📄 Generar y Ver PDF" Click="BtnGenerarPDF_Click" Width="180" Height="35" Margin="10" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#2980B9" BorderBrush="#2980B9"/>
                    <Button Content="✉️ Enviar al Correo" Click="BtnEnviarCorreo_Click" Width="180" Height="35" Margin="10" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#27AE60" BorderBrush="#27AE60"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>