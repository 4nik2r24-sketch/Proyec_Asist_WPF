<Window x:Class="AplicacionMVP.Vista.VentanaModificarTrabajador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Modificar Funcionario" Height="620" Width="420"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        Background="#F4F6F9"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Actualizar Datos del Trabajador" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50" HorizontalAlignment="Center"/>

                <TextBox x:Name="txtRut" materialDesign:HintAssist.Hint="RUT" TextChanged="Campo_TextChanged"
                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>

                <TextBox x:Name="txtNombre" materialDesign:HintAssist.Hint="Nombre" TextChanged="Campo_TextChanged"
                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>

                <TextBox x:Name="txtApPaterno" materialDesign:HintAssist.Hint="Apellido Paterno" TextChanged="Campo_TextChanged"
                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>

                <TextBox x:Name="txtApMaterno" materialDesign:HintAssist.Hint="Apellido Materno" TextChanged="Campo_TextChanged"
                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>

                <TextBox x:Name="txtCorreo" materialDesign:HintAssist.Hint="Correo Electrónico" TextChanged="Campo_TextChanged"
                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>

                <PasswordBox x:Name="txtContrasena" materialDesign:HintAssist.Hint="Contraseña" PasswordChanged="Contrasena_PasswordChanged"
                             Style="{DynamicResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,10"/>

                <ComboBox x:Name="cmbRol" materialDesign:HintAssist.Hint="Rol del Funcionario" SelectionChanged="Combo_SelectionChanged"
                          Style="{DynamicResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,10">
                    <ComboBoxItem Content="Administrador" Tag="1"/>
                    <ComboBoxItem Content="Empleado" Tag="2"/>
                </ComboBox>

                <ComboBox x:Name="cmbEstado" materialDesign:HintAssist.Hint="Estado Laboral" SelectionChanged="Combo_SelectionChanged"
                          Style="{DynamicResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,20">
                    <ComboBoxItem Content="Vigente"/>
                    <ComboBoxItem Content="Desvinculado"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Cancelar" Click="BtnCancelar_Click" Width="110" Margin="10" 
                            Style="{DynamicResource MaterialDesignOutlinedButton}"/>
                    <Button Content="Modificar" Click="BtnGuardar_Click" Width="110" Margin="10" 
                            Style="{DynamicResource MaterialDesignRaisedButton}" Background="#F39C12" BorderBrush="#F39C12"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>