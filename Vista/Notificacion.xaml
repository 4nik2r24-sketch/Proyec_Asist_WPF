<Window x:Class="AplicacionMVP.Vista.Notificacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso" Height="200" Width="350" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <!-- Borde morado oscuro, igual al botón de Gestión y Reportes -->
    <Border Background="White" CornerRadius="12" BorderBrush="#21005D" BorderThickness="2">

        <!-- Sombra sutil para que la alerta resalte sobre el panel principal -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2" Color="Black"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" Margin="20">
            <!-- Título -->
            <TextBlock Text="SISTEMA DE ASISTENCIA" Foreground="#21005D" 
                       FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Mensaje Dinámico -->
            <TextBlock x:Name="txtMensaje" Text="Aquí va el mensaje" Foreground="#333333" 
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,0,0,25"/>

            <!-- Botón Aceptar (Usando el morado vibrante de tus cabeceras) -->
            <Button Content="ACEPTAR" Width="120" Height="35" 
                    Background="#673AB7" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Click="BtnAceptar_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>