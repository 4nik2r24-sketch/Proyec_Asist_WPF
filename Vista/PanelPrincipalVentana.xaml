<Window x:Class="AplicacionMVP.Vista.PanelPrincipalVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Panel Principal - Sistema de Asistencia" Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        Background="#F4F6F9"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <!-- CONTENIDO PRINCIPAL -->
        <Grid Margin="20">
            <materialDesign:Card Padding="20" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="AccountTie" Width="50" Height="50" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock x:Name="lblNombreUsuario" Text="Bienvenido/a: (Cargando...)" 
                                   FontSize="22" FontWeight="Bold" Foreground="#2C3E50" 
                                   HorizontalAlignment="Center" Margin="0,10,0,5"/>
                        <!-- Aquí está el Reloj que faltaba -->
                        <TextBlock x:Name="lblReloj" Text="Hora actual: --:--:--" FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Button Content="MARCAR ENTRADA" Click="BtnMarcarEntrada_Click" Width="180" Height="45" 
                                Style="{DynamicResource MaterialDesignRaisedButton}" Background="#27AE60" BorderBrush="#27AE60" Margin="10,0" Foreground="White" FontWeight="Bold"/>
                        <Button Content="MARCAR SALIDA" Click="BtnMarcarSalida_Click" Width="180" Height="45" 
                                Style="{DynamicResource MaterialDesignRaisedButton}" Background="#E74C3C" BorderBrush="#E74C3C" Margin="10,0" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <GroupBox Grid.Row="2" Header="Mi Historial de Asistencia" Style="{DynamicResource MaterialDesignCardGroupBox}" Margin="0,0,0,20">
                        <DataGrid x:Name="dgHistorial" AutoGenerateColumns="True" IsReadOnly="True" 
                                  AlternatingRowBackground="#E8F8F5" HeadersVisibility="Column"/>
                    </GroupBox>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                        <Button x:Name="btnAdministrador" Content="⚙️ IR AL CENTRO DE CONTROL (ADMIN)" Click="BtnAdministrador_Click" 
                                Width="300" Height="40" Margin="0,0,0,10" Style="{DynamicResource MaterialDesignRaisedButton}" 
                                Visibility="Collapsed" materialDesign:ButtonAssist.CornerRadius="8"/>

                        <Button Content="Cerrar Sesión" Click="BtnCerrarSesion_Click" Width="160" Height="35" 
                                Style="{DynamicResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="5" 
                                Foreground="#7F8C8D" BorderBrush="#7F8C8D"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- AQUI ESTÁ EL PANEL FLOTANTE DE SEGURIDAD QUE FALTABA (OVERLAY) -->
        <Grid x:Name="OverlaySeguridad" Background="#CC000000" Visibility="Collapsed">
            <materialDesign:Card Width="340" Height="240" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Seguridad Administrativa" FontWeight="Bold" FontSize="18" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Ingrese la clave maestra para continuar:" FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Aquí está la caja de texto que faltaba -->
                    <PasswordBox x:Name="txtClaveAdmin" materialDesign:HintAssist.Hint="Contraseña de Control" 
                                 Style="{DynamicResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,8"/>

                    <!-- Aquí está el mensaje de error que faltaba -->
                    <TextBlock x:Name="lblErrorClave" Text="Contraseña incorrecta." Foreground="#E74C3C" Visibility="Collapsed" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Button Content="Cancelar" Click="BtnCancelarSeguridad_Click" Width="100" Margin="5" Style="{DynamicResource MaterialDesignOutlinedButton}"/>
                        <Button Content="Ingresar" Click="BtnConfirmarSeguridad_Click" Width="100" Margin="5" Background="#2980B9" BorderBrush="#2980B9" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>